---
import '../styles/global.css';
import { profile } from '../data/portfolio';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${profile.name} | Cybersecurity & Full-Stack`,
  description = 'Portfolio of Gerard James Paglingayen — cybersecurity, full-stack development, data privacy, AI/IoT systems, and technology project delivery.',
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL('/og-image.png', Astro.site);
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  url: Astro.site?.toString(),
  email: `mailto:${profile.email}`,
  sameAs: [profile.github, profile.linkedin],
  image: ogImageUrl.toString(),
  knowsAbout: [
    'Cybersecurity',
    'Full-Stack Development',
    'Data Privacy',
    'Application Security',
    'Machine Learning',
    'Internet of Things',
    'IT Project Delivery',
  ],
  address: {
    '@type': 'PostalAddress',
    addressRegion: 'Antique',
    addressCountry: 'PH',
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      (() => {
        const storageKey = 'portfolio-theme';
        const systemTheme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        let storedTheme = null;

        try {
          storedTheme = localStorage.getItem(storageKey);
        } catch {
          storedTheme = null;
        }

        document.documentElement.dataset.theme = storedTheme === 'dark' || storedTheme === 'light'
          ? storedTheme
          : systemTheme;

        document.documentElement.classList.add('js');
      })();
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#eef4ff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#08111f" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${profile.name} Portfolio`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Gerard James Paglingayen — Cybersecurity and Full-Stack Technology Portfolio" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content="Gerard James Paglingayen — Cybersecurity and Full-Stack Technology Portfolio" />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body id="top">
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <main class="site-main" id="main-content">
      <slot />
    </main>

    <script>
      const revealElements = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (reduceMotion || !('IntersectionObserver' in window)) {
        revealElements.forEach((element) => element.dataset.revealed = 'true');
      } else {
        const revealObserver = new IntersectionObserver(
          (entries, observer) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting || !(entry.target instanceof HTMLElement)) return;
              entry.target.dataset.revealed = 'true';
              observer.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );

        revealElements.forEach((element) => revealObserver.observe(element));
      }
    </script>
  </body>
</html>
