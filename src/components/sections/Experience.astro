---
import SectionHeading from '../ui/SectionHeading.astro';
import { experience } from '../../data/portfolio';
---

<section class="site-section" id="experience" aria-labelledby="experience-title">
  <div class="site-container">
    <SectionHeading
      eyebrow="Career"
      title="Experience & Leadership"
      id="experience-title"
      description="Technical education, institutional technology leadership, data protection, and professional ICT training across higher education and government capacity-building initiatives."
    />

    <div class="experience-list">
      {experience.map((item, index) => (
        <article class="experience-card" data-reveal>
          <div class="experience-card__meta">
            <span class="experience-card__index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <p class="experience-card__kind">{item.kind}</p>
            <p class="experience-card__dates">{item.dates}</p>
          </div>

          <div class="experience-card__body">
            <h3>{item.role}</h3>
            <p class="experience-card__organization">{item.organization}</p>
            <p class="experience-card__location">{item.location}</p>

            <ul class="experience-card__bullets">
              {item.bullets.map((bullet) => <li>{bullet}</li>)}
            </ul>

            <ul class="tag-list" aria-label={`Skills used as ${item.role}`}>
              {item.tags.map((tag) => <li>{tag}</li>)}
            </ul>
          </div>
        </article>
      ))}
    </div>

    <div class="section-cta">
      <a class="text-link" href="#projects">Explore featured project work →</a>
    </div>
  </div>
</section>

<style>
  .experience-list {
    border-top: 1px solid var(--color-border);
  }

  .experience-card {
    display: grid;
    gap: 1.5rem;
    padding-block: clamp(2rem, 5vw, 3.5rem);
    border-bottom: 1px solid var(--color-border);
  }

  .experience-card__meta {
    display: grid;
    align-content: start;
    gap: 0.45rem;
  }

  .experience-card__index {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 800;
  }

  .experience-card__kind,
  .experience-card__dates,
  .experience-card__organization,
  .experience-card__location {
    margin: 0;
  }

  .experience-card__kind {
    color: var(--color-text);
    font-size: 0.85rem;
    font-weight: 720;
  }

  .experience-card__dates,
  .experience-card__location {
    color: var(--color-text-muted);
    font-size: 0.86rem;
  }

  .experience-card__body h3 {
    margin-bottom: 0.45rem;
    font-size: clamp(1.35rem, 3vw, 2rem);
    letter-spacing: -0.03em;
  }

  .experience-card__organization {
    color: var(--color-accent);
    font-weight: 720;
  }

  .experience-card__bullets {
    display: grid;
    gap: 0.75rem;
    max-width: 54rem;
    padding-left: 1.2rem;
    margin: 1.4rem 0;
    color: var(--color-text-muted);
  }

  .experience-card__bullets li::marker {
    color: var(--color-accent);
  }

  .section-cta {
    padding-top: 1.75rem;
  }

  @media (min-width: 52rem) {
    .experience-card {
      grid-template-columns: minmax(10rem, 0.36fr) minmax(0, 1.64fr);
      gap: 3rem;
    }
  }
</style>
