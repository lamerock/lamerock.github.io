---
import SectionHeading from '../ui/SectionHeading.astro';
import { certifications, education, professionalDevelopment } from '../../data/portfolio';
---

<section class="site-section site-section--soft" id="credentials" aria-labelledby="credentials-title">
  <div class="site-container">
    <SectionHeading
      eyebrow="Education & Credentials"
      title="Education, Certifications & Learning"
      id="credentials-title"
      description="Formal technical education, professional certifications, and selected continuing development across cybersecurity, software development, digital governance, and project delivery."
    />

    <div class="credentials-grid">
      <div>
        <h3 class="credentials-group-title">Education</h3>
        <div class="credential-list">
          {education.map((item) => (
            <article class="credential-card" data-reveal>
              <div>
                <p class="credential-card__date">{item.dates}</p>
                <h4>{item.qualification}</h4>
                {item.status && <p class="credential-card__status">{item.status}</p>}
                <p>{item.institution}</p>
                <p class="credential-card__location">{item.location}</p>
              </div>
            </article>
          ))}
        </div>
      </div>

      <div>
        <h3 class="credentials-group-title">Certifications</h3>
        <div class="credential-list">
          {certifications.map((item) => (
            <article class="credential-card credential-card--compact" data-reveal>
              <p class="credential-card__date">{item.year}</p>
              <h4>{item.name}</h4>
              <p>{item.issuer}</p>
            </article>
          ))}
        </div>
      </div>
    </div>

    <details class="development" data-reveal>
      <summary>Selected professional development</summary>
      <div class="development__content">
        <p>
          Recent professional development includes cybersecurity and information-security training, ISO/IEC 27001 internal-auditor training, digital-transformation project management, digital governance, Next.js, Flask, Laravel, React, PHP, and web development.
        </p>
        <ul>
          {professionalDevelopment.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </details>
  </div>
</section>

<style>
  .credentials-grid {
    display: grid;
    gap: clamp(2.5rem, 6vw, 5rem);
  }

  .credentials-group-title {
    margin-bottom: 1.2rem;
    font-size: 1rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .credential-list {
    display: grid;
    gap: 0.8rem;
  }

  .credential-card {
    padding: 1.3rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .credential-card h4 {
    margin: 0.35rem 0 0.45rem;
    font-size: 1.05rem;
    line-height: 1.3;
  }

  .credential-card p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .credential-card__date {
    color: var(--color-accent) !important;
    font-family: var(--font-mono);
    font-size: 0.72rem !important;
    font-weight: 700;
  }

  .credential-card__status {
    margin-bottom: 0.55rem !important;
    color: var(--color-text) !important;
    font-weight: 740;
  }

  .credential-card__location {
    margin-top: 0.2rem !important;
    font-size: 0.8rem !important;
  }

  .development {
    margin-top: clamp(2.5rem, 6vw, 4rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .development summary {
    padding: 1.15rem 1.3rem;
    font-weight: 740;
    cursor: pointer;
  }

  .development__content {
    padding: 0 1.3rem 1.3rem;
    color: var(--color-text-muted);
  }

  .development__content ul {
    display: grid;
    gap: 0.55rem;
    padding-left: 1.2rem;
    margin-bottom: 0;
  }

  @media (min-width: 54rem) {
    .credentials-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
