---
import ThemeToggle from '../layout/ThemeToggle.astro';
import {
  certifications,
  education,
  experience,
  highlights,
  professionalDevelopment,
  profile,
  projects,
  research,
  skillGroups,
} from '../../data/portfolio';

const navItems = [
  ['Profile', '#about'],
  ['Projects', '#projects'],
  ['Experience', '#experience'],
  ['Research', '#research'],
  ['Skills', '#skills'],
  ['Credentials', '#credentials'],
  ['Contact', '#contact'],
] as const;

const featuredExperience = experience.slice(0, 4);
const additionalExperience = experience.slice(4);
const featuredCertifications = certifications.slice(0, 3);
const additionalCertifications = certifications.slice(3);
const coreSkills = [
  'PHP',
  'MySQL',
  'Python',
  'JavaScript',
  'Kotlin',
  'C++',
  'Laravel',
  'React',
  'Next.js',
  'Flask',
  'Git',
  'GitHub',
  'Application Security',
  'Data Privacy',
  'Incident Response',
  'TensorFlow',
  'TensorFlow Lite',
  'Android SDK',
  'Arduino',
  'Raspberry Pi',
  'Technology Project Delivery',
  'Kanban',
] as const;
---

<div class="workspace-shell">
  <div class="portfolio-grid">
    <aside class="identity-rail" aria-label="Professional profile">
      <div class="identity-card" data-reveal>
        <div class="identity-card__cover" aria-hidden="true"></div>

        <div class="identity-card__body">
          <div class="portrait-wrap">
            <img
              src="/images/profile/gerard-james-paglingayen-headshot.jpg"
              alt="Professional portrait of Gerard James Paglingayen"
              width="500"
              height="500"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
            <span class="status-dot" title="Open to professional opportunities"></span>
          </div>

          <div class="identity-copy">
            <p class="identity-kicker">Technology Portfolio</p>
            <h1>{profile.name}</h1>
            <p class="identity-role">{profile.role}</p>
            <p class="identity-summary">
              Software engineering, application security, data privacy, AI/IoT, and technology project delivery.
            </p>
          </div>

          <div class="identity-actions">
            <a class="action-primary" href={`mailto:${profile.email}`}>Email Me</a>
            <div class="identity-socials" aria-label="Professional profiles">
              <a href={profile.linkedin} target="_blank" rel="noreferrer" aria-label="LinkedIn profile">
                <span aria-hidden="true">in</span> LinkedIn
              </a>
              <a href={profile.github} target="_blank" rel="noreferrer" aria-label="GitHub profile">
                <span aria-hidden="true">GH</span> GitHub
              </a>
            </div>
          </div>

          <dl class="profile-facts">
            <div>
              <dt>Location</dt>
              <dd>{profile.location}</dd>
            </div>
            <div>
              <dt>Status</dt>
              <dd>Open to opportunities</dd>
            </div>
            <div>
              <dt>Focus</dt>
              <dd>Development · Security · IT</dd>
            </div>
          </dl>

        </div>
      </div>
    </aside>

    <nav class="workspace-nav" aria-label="Portfolio sections">
      <a class="workspace-nav__home" href="#about" aria-label="Go to profile section">
        <span class="workspace-nav__mark" aria-hidden="true">GJ</span>
        <span class="workspace-nav__title">Portfolio</span>
      </a>

      <div class="workspace-nav__links">
        {navItems.map(([label, href]) => (
          <a href={href} data-dashboard-link>{label}</a>
        ))}
      </div>

      <div class="workspace-nav__theme" aria-label="Color theme">
        <ThemeToggle />
      </div>
    </nav>

    <main class="primary-column">
      <section class="panel intro-panel" id="about" aria-labelledby="about-title" data-reveal>
        <div class="panel-heading panel-heading--split">
          <div>
            <p class="section-label">Profile</p>
            <h2 id="about-title">Engineering depth with institutional perspective.</h2>
          </div>
          <span class="availability-pill"><span></span> Available for opportunities</span>
        </div>

        <p class="intro-lead">{profile.summary}</p>

        <div class="snapshot-grid" aria-label="Professional highlights">
          {highlights.map((item, index) => (
            <div class="snapshot-item">
              <strong>{String(index + 1).padStart(2, '0')}</strong>
              <span>{item}</span>
            </div>
          ))}
        </div>
      </section>

      <section class="panel" id="projects" aria-labelledby="projects-title" data-reveal>
        <div class="panel-heading">
          <p class="section-label">Selected Work</p>
          <h2 id="projects-title">Featured technical projects</h2>
          <p>Commissioned work spanning secure web applications, mobile machine learning, IoT integration, and embedded process automation.</p>
        </div>

        <div class="project-stack">
          {projects.map((project, index) => (
            <article class="project-card">
              <div class="project-card__media">
                <img src={project.image} alt={project.imageAlt} width="960" height="640" loading="lazy" />
                <span class="project-index">0{index + 1}</span>
              </div>

              <div class="project-card__body">
                <div class="project-meta">
                  <span>{project.year}</span>
                  <span>Commissioned Project</span>
                </div>
                <h3>{project.title}</h3>
                <p class="project-role">{project.role}</p>
                <p>{project.description}</p>

                <div class="project-focus">
                  {project.focus.map((item) => <span>{item}</span>)}
                </div>

                <div class="project-tech" aria-label={`${project.title} technologies`}>
                  {project.technologies.map((technology) => <span>{technology}</span>)}
                </div>

                <div class="project-links" aria-label={`${project.title} links`}>
                  {project.demoUrl ? (
                    <a href={project.demoUrl} target="_blank" rel="noreferrer">Live demo ↗</a>
                  ) : (
                    <span>Live demo · pending</span>
                  )}
                  {project.repositoryUrl ? (
                    <a href={project.repositoryUrl} target="_blank" rel="noreferrer">Repository ↗</a>
                  ) : (
                    <span>Repository · pending</span>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="panel" id="experience" aria-labelledby="experience-title" data-reveal>
        <div class="panel-heading">
          <p class="section-label">Career</p>
          <h2 id="experience-title">Experience & leadership</h2>
          <p>Technical education, institutional technology leadership, data protection, planning, and professional ICT training.</p>
        </div>

        <div class="experience-list">
          {featuredExperience.map((item) => (
            <article class="experience-item">
              <div class="experience-item__top">
                <div>
                  <p class="experience-kind">{item.kind}</p>
                  <h3>{item.role}</h3>
                  <p class="experience-org">{item.organization}</p>
                </div>
                <time>{item.dates}</time>
              </div>
              <ul>
                {item.bullets.slice(0, 4).map((bullet) => <li>{bullet}</li>)}
              </ul>
              <div class="tag-row">
                {item.tags.slice(0, 5).map((tag) => <span>{tag}</span>)}
              </div>
            </article>
          ))}
        </div>

        {additionalExperience.length > 0 && (
          <details class="more-experience">
            <summary>Additional professional engagements</summary>
            <div class="more-experience__list">
              {additionalExperience.map((item) => (
                <article>
                  <div>
                    <h3>{item.role}</h3>
                    <p>{item.organization}</p>
                  </div>
                  <time>{item.dates}</time>
                </article>
              ))}
            </div>
          </details>
        )}
      </section>

      <section class="panel research-panel" id="research" aria-labelledby="research-title" data-reveal>
        <div class="panel-heading">
          <p class="section-label">Research & Innovation</p>
          <h2 id="research-title">Published and protected technical work</h2>
        </div>

        <div class="research-list">
          {research.map((item) => (
            <article>
              <div>
                <p class="research-source">{item.publication} · {item.date}</p>
                <h3>{item.title}</h3>
                <p>{item.detail}</p>
              </div>
              <span class="research-reference">{item.reference}</span>
            </article>
          ))}
        </div>
      </section>

      <section class="contact-panel" id="contact" aria-labelledby="contact-title" data-reveal>
        <div>
          <p class="section-label">Contact</p>
          <h2 id="contact-title">Let’s discuss a technical opportunity.</h2>
          <p>{profile.availability}</p>
        </div>
        <div class="contact-actions">
          <a href={`mailto:${profile.email}`}>Send an email</a>
          <a href={profile.linkedin} target="_blank" rel="noreferrer">Connect on LinkedIn</a>
        </div>
      </section>
    </main>

    <aside class="support-column" aria-label="Technical skills and credentials">
      <section class="panel compact-panel" id="skills" aria-labelledby="skills-title" data-reveal>
        <div class="panel-heading panel-heading--compact">
          <p class="section-label">Capability Map</p>
          <h2 id="skills-title">Technical expertise</h2>
        </div>

        <div class="core-skill-list" aria-label="Core technologies and practices">
          {coreSkills.map((item) => <span>{item}</span>)}
        </div>

        <details class="capability-details">
          <summary>View full capability map</summary>
          <div class="skill-groups">
            {skillGroups.map((group) => (
              <section class="skill-group">
                <h3>{group.title}</h3>
                <div class="tag-row">
                  {group.items.map((item) => <span>{item}</span>)}
                </div>
              </section>
            ))}
          </div>
        </details>
      </section>

      <section class="panel compact-panel" id="credentials" aria-labelledby="credentials-title" data-reveal>
        <div class="panel-heading panel-heading--compact">
          <p class="section-label">Credentials</p>
          <h2 id="credentials-title">Education & certifications</h2>
        </div>

        <div class="credential-block">
          <h3>Education</h3>
          {education.map((item) => (
            <article class="credential-item">
              <strong>{item.qualification}</strong>
              {item.status && <span class="credential-status">{item.status}</span>}
              <span>{item.institution}</span>
              <small>{item.dates}</small>
            </article>
          ))}
        </div>

        <div class="credential-block">
          <h3>Selected certifications</h3>
          {featuredCertifications.map((item) => (
            <article class="cert-item">
              <span class="cert-mark" aria-hidden="true">✓</span>
              <div>
                <strong>{item.name}</strong>
                <span>{item.issuer} · {item.year}</span>
              </div>
            </article>
          ))}

          {additionalCertifications.length > 0 && (
            <details class="credential-details">
              <summary>Additional certifications</summary>
              <div class="credential-details__list">
                {additionalCertifications.map((item) => (
                  <article class="cert-item">
                    <span class="cert-mark" aria-hidden="true">✓</span>
                    <div>
                      <strong>{item.name}</strong>
                      <span>{item.issuer} · {item.year}</span>
                    </div>
                  </article>
                ))}
              </div>
            </details>
          )}
        </div>

        <details class="learning-details">
          <summary>Selected professional development</summary>
          <ul>
            {professionalDevelopment.map((item) => <li>{item}</li>)}
          </ul>
        </details>
      </section>

    </aside>
  </div>

  <footer class="workspace-footer">
    <p>© {new Date().getFullYear()} {profile.name}</p>
    <p>Designed as a one-page technical portfolio.</p>
    <a href="#top">Back to top ↑</a>
  </footer>
</div>

<script>
  const dashboardLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-dashboard-link]'));
  const workspaceNav = document.querySelector<HTMLElement>('.workspace-nav');
  const targets = dashboardLinks
    .map((link) => document.querySelector<HTMLElement>(link.getAttribute('href') ?? ''))
    .filter((section): section is HTMLElement => Boolean(section));

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let activeSection = '';
  let updateQueued = false;

  const setActiveSection = (id: string) => {
    if (!id || id === activeSection) return;
    activeSection = id;

    dashboardLinks.forEach((link) => {
      const isActive = link.getAttribute('href') === `#${id}`;
      if (isActive) {
        link.setAttribute('aria-current', 'location');
        link.scrollIntoView({
          block: 'nearest',
          inline: 'nearest',
          behavior: reduceMotion ? 'auto' : 'smooth',
        });
      } else {
        link.removeAttribute('aria-current');
      }
    });
  };

  const updateActiveSection = () => {
    updateQueued = false;
    if (!targets.length) return;

    const navHeight = workspaceNav?.getBoundingClientRect().height ?? 64;
    const readingLine = Math.min(window.innerHeight * 0.22, navHeight + 42);
    const atPageEnd = window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 12;

    if (atPageEnd) {
      setActiveSection(targets[targets.length - 1].id);
      return;
    }

    let nearest = targets[0];
    let bestScore = Number.POSITIVE_INFINITY;

    targets.forEach((target, index) => {
      const rect = target.getBoundingClientRect();
      const containsReadingLine = rect.top <= readingLine && rect.bottom >= readingLine;
      const topDistance = Math.abs(rect.top - readingLine);
      // Prefer the section containing the reading line. Use DOM/navigation order as a stable tie-breaker.
      const score = (containsReadingLine ? -100000 : 0) + topDistance + index * 0.001;

      if (score < bestScore) {
        bestScore = score;
        nearest = target;
      }
    });

    setActiveSection(nearest.id);
  };

  const queueActiveUpdate = () => {
    if (updateQueued) return;
    updateQueued = true;
    window.requestAnimationFrame(updateActiveSection);
  };

  dashboardLinks.forEach((link) => {
    link.addEventListener('click', () => {
      const id = link.getAttribute('href')?.slice(1);
      if (id) setActiveSection(id);
    });
  });

  updateActiveSection();
  window.addEventListener('scroll', queueActiveUpdate, { passive: true });
  window.addEventListener('resize', queueActiveUpdate);
</script>

<style>
  .workspace-shell {
    width: min(calc(100% - 2rem), 94rem);
    margin-inline: auto;
    padding-block: 1rem 2rem;
  }

  .portfolio-grid {
    display: grid;
    grid-template-columns: minmax(15rem, 18rem) minmax(0, 1fr) minmax(17rem, 20rem);
    align-items: start;
    gap: 1rem;
  }

  .identity-rail {
    position: sticky;
    top: 1rem;
    grid-column: 1;
    grid-row: 1 / span 2;
  }

  .workspace-nav {
    position: sticky;
    z-index: 40;
    top: 1rem;
    grid-column: 2 / 4;
    grid-row: 1;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    min-height: 3.9rem;
    padding: 0.45rem 0.55rem;
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    background: color-mix(in srgb, var(--color-surface) 91%, transparent);
    box-shadow: var(--shadow-sm);
    backdrop-filter: blur(18px) saturate(140%);
  }

  .workspace-nav__home {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-width: 0;
    text-decoration: none;
  }

  .workspace-nav__mark {
    display: grid;
    width: 2.3rem;
    height: 2.3rem;
    flex: 0 0 auto;
    place-items: center;
    border-radius: 0.68rem;
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 850;
  }

  .workspace-nav__title {
    color: var(--color-text);
    font-size: 0.78rem;
    font-weight: 800;
  }

  .workspace-nav__links {
    display: flex;
    min-width: 0;
    align-items: center;
    justify-content: center;
    gap: 0.1rem;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scrollbar-width: none;
  }

  .workspace-nav__links::-webkit-scrollbar {
    display: none;
  }

  .workspace-nav__links a {
    display: inline-flex;
    min-height: 2.75rem;
    flex: 0 0 auto;
    align-items: center;
    padding: 0.5rem 0.63rem;
    border-radius: 0.58rem;
    color: var(--color-text-muted);
    font-size: 0.72rem;
    font-weight: 740;
    text-decoration: none;
    white-space: nowrap;
  }

  .workspace-nav__links a:hover,
  .workspace-nav__links a[aria-current='location'] {
    background: var(--color-accent-soft);
    color: var(--color-accent-strong);
  }

  .workspace-nav__theme {
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  .primary-column {
    grid-column: 2;
    grid-row: 2;
  }

  .support-column {
    grid-column: 3;
    grid-row: 2;
  }

  .identity-card,
  .panel,
  .contact-panel {
    border: 1px solid var(--color-border);
    border-radius: 1.25rem;
    background: color-mix(in srgb, var(--color-surface) 96%, transparent);
    box-shadow: var(--shadow-sm);
  }

  .identity-card {
    overflow: hidden;
  }

  .identity-card__cover {
    height: 5.4rem;
    background:
      linear-gradient(135deg, rgb(255 255 255 / 0.13), transparent 45%),
      linear-gradient(120deg, var(--color-accent-strong), var(--color-accent), var(--color-warm));
  }

  .identity-card__body {
    padding: 0 1.15rem 1.15rem;
  }

  .portrait-wrap {
    position: relative;
    width: 7.2rem;
    margin-top: -3.6rem;
    margin-bottom: 0.95rem;
  }

  .portrait-wrap img {
    width: 7.2rem;
    height: 7.2rem;
    border: 4px solid var(--color-surface);
    border-radius: 1.35rem;
    object-fit: cover;
    object-position: center 28%;
    box-shadow: var(--shadow-md);
  }

  .status-dot {
    position: absolute;
    right: -0.05rem;
    bottom: 0.5rem;
    width: 1rem;
    height: 1rem;
    border: 3px solid var(--color-surface);
    border-radius: 999px;
    background: #22c55e;
  }

  .identity-kicker,
  .section-label,
  .experience-kind,
  .research-source {
    margin: 0 0 0.4rem;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .identity-copy h1 {
    margin-bottom: 0.35rem;
    font-size: 1.55rem;
    letter-spacing: -0.04em;
  }

  .identity-role {
    margin-bottom: 0.65rem;
    color: var(--color-accent-strong);
    font-size: 0.92rem;
    font-weight: 760;
    line-height: 1.35;
  }

  .identity-summary {
    margin-bottom: 1rem;
    color: var(--color-text-muted);
    font-size: 0.84rem;
    line-height: 1.55;
  }

  .identity-actions {
    display: grid;
    gap: 0.65rem;
    margin-bottom: 1rem;
  }

  .identity-actions > .action-primary,
  .contact-actions a {
    display: inline-flex;
    min-height: 2.65rem;
    align-items: center;
    justify-content: center;
    padding: 0.65rem 0.8rem;
    border: 1px solid var(--color-border);
    border-radius: 0.72rem;
    font-size: 0.82rem;
    font-weight: 760;
    text-decoration: none;
  }

  .action-primary,
  .contact-actions a:first-child {
    border-color: var(--color-accent) !important;
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  .action-primary:hover,
  .contact-actions a:first-child:hover {
    background: var(--color-accent-strong);
  }

  .contact-actions a:last-child:hover {
    border-color: var(--color-accent);
    color: var(--color-accent-strong);
  }

  .identity-socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.8rem;
  }

  .identity-socials a {
    display: inline-flex;
    min-height: 2.5rem;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-text-muted);
    font-size: 0.72rem;
    font-weight: 740;
    text-decoration: none;
  }

  .identity-socials a:hover {
    color: var(--color-accent-strong);
  }

  .identity-socials a span {
    display: inline-grid;
    min-width: 1.55rem;
    height: 1.55rem;
    place-items: center;
    border: 1px solid var(--color-border);
    border-radius: 0.45rem;
    background: var(--color-surface-muted);
    color: var(--color-accent-strong);
    font-family: var(--font-mono);
    font-size: 0.57rem;
    font-weight: 850;
  }

  .profile-facts {
    display: grid;
    gap: 0.6rem;
    padding: 0.9rem 0;
    margin: 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .profile-facts div {
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: 0.55rem;
    align-items: baseline;
  }

  .profile-facts dt {
    color: var(--color-text-muted);
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .profile-facts dd {
    margin: 0;
    font-size: 0.77rem;
    font-weight: 650;
  }

  .primary-column,
  .support-column {
    display: grid;
    gap: 1rem;
  }

  .panel,
  .contact-panel {
    padding: clamp(1.15rem, 2vw, 1.7rem);
    scroll-margin-top: 5.8rem;
  }

  .panel-heading {
    margin-bottom: 1.25rem;
  }

  .panel-heading--split {
    display: flex;
    justify-content: space-between;
    gap: 1.25rem;
    align-items: flex-start;
  }

  .panel-heading--compact {
    margin-bottom: 1rem;
  }

  .panel-heading h2,
  .contact-panel h2 {
    max-width: 19ch;
    margin-bottom: 0.55rem;
    font-size: clamp(1.45rem, 2.5vw, 2.15rem);
    letter-spacing: -0.045em;
  }

  .compact-panel .panel-heading h2 {
    font-size: 1.28rem;
  }

  .panel-heading > p:last-child,
  .intro-lead,
  .contact-panel > div > p:last-child {
    color: var(--color-text-muted);
    font-size: 0.92rem;
  }

  .intro-lead {
    max-width: 72ch;
    margin-bottom: 1.25rem;
    font-size: 1rem;
  }

  .availability-pill {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.4rem;
    padding: 0.42rem 0.65rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface-muted);
    color: var(--color-text-muted);
    font-size: 0.7rem;
    font-weight: 700;
  }

  .availability-pill span {
    width: 0.48rem;
    height: 0.48rem;
    border-radius: 999px;
    background: #22c55e;
  }

  .snapshot-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.65rem;
  }

  .snapshot-item {
    min-height: 6rem;
