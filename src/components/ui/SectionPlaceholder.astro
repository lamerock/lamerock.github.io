---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  description: string;
}

const { id, eyebrow, title, description } = Astro.props;
---

<section class="site-section" id={id} aria-labelledby={`${id}-title`}>
  <div class="site-container">
    <div class="placeholder-card">
      <div>
        <p class="eyebrow">{eyebrow}</p>
        <h2 id={`${id}-title`}>{title}</h2>
      </div>
      <p>{description}</p>
      <span class="placeholder-badge">Phase 1 placeholder</span>
    </div>
  </div>
</section>
